rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Default Deny: All access blocked by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 3 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Authorized Admin: Only creationsaifali@gmail.com or registered admin document
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'creationsaifali@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation for new customer booking creation
    function isValidBooking(data) {
      return data.keys().hasAll([
        'bookingId', 'customerName', 'phone', 'service', 'area', 'workDetails', 'status', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'bookingId', 'customerName', 'phone', 'service', 'area', 'landmark', 'workDetails',
        'preferredTime', 'status', 'assignedProviderId', 'assignedProviderName', 'createdAt', 'updatedAt', 'source', 'notes'
      ]) &&
      data.bookingId is string && data.bookingId.size() <= 64 &&
      data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100 &&
      data.phone is string && data.phone.size() >= 10 && data.phone.size() <= 15 &&
      data.service is string && data.service.size() <= 100 &&
      data.area is string && data.area.size() <= 100 &&
      data.workDetails is string && data.workDetails.size() >= 2 && data.workDetails.size() <= 1000 &&
      data.status in ['pending', 'confirmed', 'assigned', 'completed', 'cancelled'] &&
      data.createdAt is string && data.createdAt.size() <= 50;
    }

    // 2. Customer Bookings Collection (/bookings/{bookingId})
    // - Customers can CREATE with strict schema (status MUST be 'pending')
    // - Unauthenticated users CANNOT read or list bookings (protects customer phone numbers)
    // - Only authorized Admin (creationsaifali@gmail.com) can READ, LIST, UPDATE status, or DELETE
    match /bookings/{bookingId} {
      allow create: if isValidId(bookingId) &&
        isValidBooking(request.resource.data) &&
        request.resource.data.bookingId == bookingId &&
        request.resource.data.status == 'pending';

      allow read: if isAdmin();

      allow update, delete: if isAdmin();
    }

    // 3. Verified Providers Collection (/providers/{providerId})
    // - Public can read genuine verified technicians vetted by LucknowSeva
    // - Only Admin can create, edit, or delete provider records
    match /providers/{providerId} {
      allow read: if isValidId(providerId);
      allow write: if isAdmin();
    }

    // 4. Admins Collection (/admins/{adminId})
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
